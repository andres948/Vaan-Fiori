# Copia este archivo como .env y completa con tus credenciales de Supabase.
# Mientras estas variables no estén definidas, la aplicación funciona en
# modo demostración con datos guardados en el navegador (localStorage).

VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=tu-anon-key-publica
